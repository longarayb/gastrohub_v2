# Production .env template (docs/DEPLOY.md). deploy/gen-secrets.sh copies it to /opt/app/.env
# (mode 600, owner deploy) and fills every <gerado> with a random value. The <preencher> ones are
# typed in by hand. Never commit the filled file: keep a copy in the password manager.

NODE_ENV=production
TZ=UTC
APP_NAME=

# ---------- Addresses ----------
# sslip.io from the VM IP for now (e.g. 203-0-113-10.sslip.io); the real domain later.
BASE_DOMAIN=<preencher>
API_PUBLIC_URL=https://api.${BASE_DOMAIN}
WEB_PUBLIC_URL=https://painel.${BASE_DOMAIN}
MENU_PUBLIC_URL=https://cardapio.${BASE_DOMAIN}
ADMIN_PUBLIC_URL=https://admin.${BASE_DOMAIN}
API_CORS_ORIGINS=https://painel.${BASE_DOMAIN},https://cardapio.${BASE_DOMAIN},https://admin.${BASE_DOMAIN}
# Let's Encrypt account (expiry notices).
ACME_EMAIL=<preencher>

# ---------- Images (GHCR) and version (deploy.sh writes APP_VERSION) ----------
IMAGE_PREFIX=ghcr.io/longarayb
APP_VERSION=

# ---------- Database (PostgreSQL 17 on the VM, gateway of app_net) ----------
DB_OWNER_PASSWORD=<gerado>
DB_APP_PASSWORD=<gerado>
# The API: data only. The migrations: owner of the tables.
DATABASE_URL=postgresql://app:${DB_APP_PASSWORD}@172.30.0.1:5432/app_db?schema=public
DATABASE_URL_OWNER=postgresql://app_owner:${DB_OWNER_PASSWORD}@172.30.0.1:5432/app_db?schema=public

# ---------- Redis (container, no published port) ----------
REDIS_PASSWORD=<gerado>
QUEUE_PREFIX=bull

# ---------- Secrets ----------
JWT_ACCESS_SECRET=<gerado>
JWT_REFRESH_SECRET=<gerado>
PLATFORM_JWT_SECRET=<gerado>
# KEEP A COPY OUTSIDE THE SERVER: if lost, every admin redoes the 2FA (docs/SETUP.md).
PLATFORM_SECRETS_KEY=<gerado>
MENU_REVALIDATE_SECRET=<gerado>
LOGIN_RATE_LIMIT_PER_MINUTE=10
PLATFORM_LOGIN_RATE_LIMIT_PER_MINUTE=
PLATFORM_ALLOWED_IPS=

# ---------- E-mail (Brevo) ----------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=<preencher>
SMTP_PASSWORD=<preencher>
MAIL_FROM_ADDRESS=<preencher>

# ---------- Other ----------
GEOCODING_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=<preencher>
# Dispatch routes (D048). Public OSRM only while this is a demo; production with customers runs
# its own OSRM with the region extract (docs/PROPOSTA_DISPATCH.md).
ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org

# ---------- Public demo (D045) ----------
DEMO_RESET_ENABLED=true

# ---------- Logs (Dozzle at logs.<base>) ----------
DOZZLE_USER=admin
# bcrypt hash in base64 (Caddy); the password is shown ONCE by gen-secrets.sh.
DOZZLE_PASSWORD_HASH=<gerado>

# ---------- Backups (backup.sh) ----------
# age PUBLIC key (age1...). The private key exists only in the password manager.
BACKUP_AGE_RECIPIENT=<preencher>
# rclone remote and bucket, e.g. b2:app-backups (rclone config in /root/.config/rclone).
BACKUP_REMOTE=<preencher>
# Healthchecks.io ping URLs.
HC_BACKUP_URL=<preencher>
HC_MONITOR_URL=<preencher>
