# Environment variables (DEVELOPMENT VALUES ONLY)
# Copy to `.env` (pnpm setup does it for you). Never commit `.env`.

# Product display name in e-mails and API docs (defaults to BRAND.name in packages/shared/src/brand.ts)
APP_NAME=

NODE_ENV=development
TZ=UTC

# ---------- Docker host ports (change per machine if a port is taken; URLs below follow) ----------
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------- API ----------
API_PORT=3333
# Login attempts per minute and IP. Production: 10 (the default when empty). The high value
# below lets the visual walkthroughs (tools/ui-walkthrough) run one after another.
LOGIN_RATE_LIMIT_PER_MINUTE=300
API_PUBLIC_URL=http://localhost:3333
# Comma-separated list of allowed browser origins
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

DATABASE_URL=postgresql://app:app_dev@localhost:${POSTGRES_PORT}/app_db?schema=public
DATABASE_URL_TEST=postgresql://app:app_dev@localhost:${POSTGRES_PORT}/app_db_test?schema=public
REDIS_URL=redis://localhost:${REDIS_PORT}

# Generate real secrets for production: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-0000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# E-mail (Mailpit in development: UI at http://localhost:${MAILPIT_UI_PORT}, default 8025)
SMTP_HOST=localhost
SMTP_PORT=${MAILPIT_SMTP_PORT}
MAIL_FROM_ADDRESS=nao-responda@app.local

# Public URLs used in e-mails and links
WEB_PUBLIC_URL=http://localhost:3000
MENU_PUBLIC_URL=http://localhost:3001

# Local file storage for uploads (logos, product photos)
STORAGE_DIR=uploads

# Geocoding (Nominatim / OpenStreetMap). Set a contact e-mail per their usage policy.
GEOCODING_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=

# ---------- Frontends ----------
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_MENU_URL=http://localhost:3001
# Used by the menu app for server-side fetches (same as public URL outside Docker)
API_INTERNAL_URL=http://localhost:3333

# ---------- Low-memory machines (optional) ----------
# Parallel Turborepo tasks in `pnpm check` (default 2) and Next.js build workers (default 2).
CHECK_CONCURRENCY=
NEXT_BUILD_CPUS=
