# Environment variables (DEVELOPMENT VALUES ONLY)
# Copy to `.env` (pnpm setup does it for you). Never commit `.env`.

# Product display name in e-mails and API docs (defaults to BRAND.name in packages/shared/src/brand.ts)
APP_NAME=

NODE_ENV=development
TZ=UTC

# ---------- API ----------
API_PORT=3333
API_PUBLIC_URL=http://localhost:3333
# Comma-separated list of allowed browser origins
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

DATABASE_URL=postgresql://app:app_dev@localhost:5433/app_db?schema=public
DATABASE_URL_TEST=postgresql://app:app_dev@localhost:5433/app_db_test?schema=public
REDIS_URL=redis://localhost:6379

# Generate real secrets for production: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-0000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# E-mail (Mailpit in development: UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM_ADDRESS=nao-responda@app.local

# Public URLs used in e-mails and links
WEB_PUBLIC_URL=http://localhost:3000
MENU_PUBLIC_URL=http://localhost:3001

# Local file storage for uploads (logos, product photos)
STORAGE_DIR=uploads

# Geocoding (Nominatim / OpenStreetMap). Set a contact e-mail per their usage policy.
GEOCODING_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=

# ---------- Frontends ----------
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_MENU_URL=http://localhost:3001
# Used by the menu app for server-side fetches (same as public URL outside Docker)
API_INTERNAL_URL=http://localhost:3333
