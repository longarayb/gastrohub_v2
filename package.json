{
  "name": "app-monorepo",
  "private": true,
  "description": "Gestão para restaurantes, bares e deliveries (nome do produto em packages/shared/src/brand.ts)",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lite": "turbo run dev --filter=@app/api --filter=@app/web --filter=./packages/* --concurrency=4",
    "start:lite": "node scripts/start-lite.mjs",
    "dev:apps": "turbo run dev --filter=./apps/* --filter=./packages/*",
    "build": "turbo run build",
    "check": "node scripts/check.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait postgres redis mailpit",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @app/api db:generate",
    "db:migrate": "pnpm --filter @app/api db:migrate",
    "db:reset": "pnpm --filter @app/api db:reset",
    "db:seed": "pnpm --filter @app/api db:seed",
    "db:studio": "pnpm --filter @app/api db:studio",
    "bootstrap": "node scripts/bootstrap.mjs",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "check:imports": "node scripts/check-tracked-imports.mjs",
    "lan:links": "node scripts/lan-links.mjs",
    "tunnel:menu": "node scripts/tunnel-menu.mjs"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  }
}
