# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Tests
coverage/
playwright-report/
test-results/

# Environment (never commit secrets — only .env.example)
.env
.env.*
!.env.example

# Generated code (Prisma Client is generated on install)
apps/api/src/generated/

# Uploads / local storage
apps/api/uploads/
/storage/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code local settings
.claude/settings.local.json

# Brand assets copied from packages/ui/assets/brand by scripts/sync-brand-assets.mjs
apps/*/public/brand/

# Local design references (may contain third-party/real data; never commit)
/docs/design/

# Print agent: local data (virtual prints, credential), release outputs and the WinSW binary
/apps/print-agent/.data/
/apps/print-agent/release/
/apps/print-agent/installer/vendor/

# Redesign screenshots per phase (tools/ui-walkthrough/screens.mjs); only docs/screenshots/final/ is versioned
/docs/screenshots/redesign/
