{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest --project unit",
    "clean": "rimraf dist .turbo coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma generate && prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.11",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^13.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.0.14",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.2",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.1.2",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.0.5"
  }
}
