// Database schema
// Rules:
//  - Money is always an integer in cents (fields ending in `Cents`).
//  - Percentages are integers in basis points (fields ending in `Bps`, 1000 = 10%).
//  - Every business table has `tenantId` (= Store.id) and is listed in
//    `src/core/tenancy/tenant-models.ts` so the Prisma extension scopes it automatically.
//  - Declare it as: tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text)"))
//    The extension always fills it; the DB default makes the field optional in the
//    generated types and makes Postgres reject inserts that bypass the extension.
//  - In writes to tenant models, use scalar foreign keys (`productId`), not `connect`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Tenancy & access
// ============================================================================

enum Role {
  OWNER
  MANAGER
  CASHIER
  WAITER
  KITCHEN
  COURIER
}

enum PizzaPricingRule {
  HIGHEST
  AVERAGE
}

/// Group of stores owned by the same business owner.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores Store[]
}

/// A restaurant unit. **This is the tenant.**
model Store {
  id             String  @id @default(cuid())
  organizationId String
  slug           String  @unique
  tradeName      String
  legalName      String
  cnpj           String
  phone          String
  email          String?
  logoUrl        String?
  timezone       String  @default("America/Sao_Paulo")
  isActive       Boolean @default(true)

  addressCep          String?
  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  addressReference    String?
  latitude            Float?
  longitude           Float?

  // Settings
  serviceFeeBps           Int              @default(1000)
  digitalMenuEnabled      Boolean          @default(true)
  deliveryMinimumCents    Int              @default(0)
  takeoutEtaMinutes       Int              @default(20)
  autoAcceptDigitalOrders Boolean          @default(false)
  pizzaPricingRule        PizzaPricingRule @default(HIGHEST)
  /// Order types that get the service fee by default (dine-in only unless configured).
  serviceFeeOrderTypes    OrderType[]      @default([DINE_IN])
  /// Blind cash close: the operator counts without seeing the expected amounts.
  blindCashClose          Boolean          @default(true)
  /// Default courier pay (D030): per delivery, share of the delivery fee (bps), daily.
  courierPerDeliveryCents Int              @default(0)
  courierFeeShareBps      Int              @default(0)
  courierDailyCents       Int              @default(0)

  /// PIX key for the static QR Code (normalized: digits, lowercase e-mail, +55 phone).
  pixKeyType      PixKeyType?
  pixKey          String?
  /// BR Code limits: name up to 25 characters, city up to 15.
  pixMerchantName String?
  pixMerchantCity String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id])
  memberships   Membership[]
  businessHours BusinessHours[]
  auditLogs     AuditLog[]

  @@index([organizationId])
}

model BusinessHours {
  id       String @id @default(cuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  /// 0 = Sunday ... 6 = Saturday
  weekday  Int
  /// "HH:mm"; when closesAt < opensAt the interval crosses midnight.
  opensAt  String
  closesAt String

  store Store @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, weekday])
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  /// Store selected on the last login, used as default on the next one.
  lastStoreId  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships         Membership[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
}

/// Access of a user to a store, with a role in that store.
model Membership {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  userId    String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  /// Tokens issued from the same login share a family; reuse of a rotated token revokes the family.
  familyId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedAt DateTime?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Audit trail for sensitive operations (cancellations, discounts, price changes, permissions).
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  userId    String?
  action    String
  entity    String
  entityId  String?
  reason    String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  store Store @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
}

// ============================================================================
// Menu (per unit — see docs/DECISOES.md D015/D016)
// Relations to Store are omitted on purpose: tenantId is a scalar filled by the
// tenant extension. Use scalar foreign keys in writes.
// ============================================================================

enum SalesChannel {
  DINE_IN
  COUNTER
  DELIVERY
  DIGITAL_MENU
}

enum CategoryKind {
  STANDARD
  PIZZA
}

enum ProductKind {
  STANDARD
  SIZED
}

/// Kitchen, bar, pizza oven... Used by the KDS and printing to route items.
model ProductionSector {
  id               String   @id @default(cuid())
  tenantId         String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  name             String
  sortOrder        Int      @default(0)
  /// Sector used for products without an explicit sector.
  isDefault        Boolean  @default(false)
  isActive         Boolean  @default(true)
  /// KDS timer alerts, in minutes since the ticket was sent (yellow, then red).
  warnAfterMinutes Int      @default(10)
  lateAfterMinutes Int      @default(20)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products Product[]
  tasks    ProductionTask[]

  @@index([tenantId, sortOrder])
}

model Category {
  id          String         @id @default(cuid())
  tenantId    String         @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  name        String
  description String?
  kind        CategoryKind   @default(STANDARD)
  sortOrder   Int            @default(0)
  isPaused    Boolean        @default(false)
  /// End of the pause ("Acabou" = end of the business day); null = indefinite.
  pausedUntil DateTime?
  channels    SalesChannel[] @default([DINE_IN, COUNTER, DELIVERY, DIGITAL_MENU])
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  products      Product[]
  /// PIZZA categories: sizes shared by every flavor.
  sizes         Size[]
  modifierLinks ModifierGroupLink[]
  schedules     AvailabilitySchedule[]

  @@index([tenantId, sortOrder])
}

model Product {
  id              String         @id @default(cuid())
  tenantId        String         @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  categoryId      String
  /// Inside a PIZZA category every product is a flavor priced per category size.
  kind            ProductKind    @default(STANDARD)
  name            String
  description     String?
  /// Storage keys (URLs are derived by the StorageProvider).
  imageKey        String?
  thumbKey        String?
  /// STANDARD products only; sized products and pizza flavors use ProductSizePrice.
  priceCents      Int?
  promoPriceCents Int?
  /// Internal/POS code, unique per unit (cleared on soft delete).
  sku             String?
  /// External integration code (iFood etc.).
  externalCode    String?
  sectorId        String?
  sortOrder       Int            @default(0)
  isPaused        Boolean        @default(false)
  pausedUntil     DateTime?
  channels        SalesChannel[] @default([DINE_IN, COUNTER, DELIVERY, DIGITAL_MENU])
  /// Name + sku + description, lowercase and without accents (search).
  searchText      String         @default("")
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  category      Category               @relation(fields: [categoryId], references: [id])
  sector        ProductionSector?      @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  sizes         Size[]
  sizePrices    ProductSizePrice[]
  modifierLinks ModifierGroupLink[]
  schedules     AvailabilitySchedule[]
  /// Combo options that reference this product.
  referencedBy  ModifierOption[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId, sortOrder])
  @@index([tenantId, deletedAt])
}

/// Size owned by a PIZZA category (shared by flavors) or by a SIZED product. Exactly one owner (CHECK).
model Size {
  id           String   @id @default(cuid())
  tenantId     String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  categoryId   String?
  productId    String?
  name         String
  sortOrder    Int      @default(0)
  /// Pizza: maximum number of flavors in this size.
  maxFlavors   Int      @default(1)
  /// Pizza: number of slices (informative).
  slices       Int?
  externalCode String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category     Category?                 @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product      Product?                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices       ProductSizePrice[]
  optionPrices ModifierOptionSizePrice[]

  @@index([tenantId, categoryId])
  @@index([tenantId, productId])
}

model ProductSizePrice {
  id              String    @id @default(cuid())
  tenantId        String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  productId       String
  sizeId          String
  priceCents      Int
  promoPriceCents Int?
  isPaused        Boolean   @default(false)
  pausedUntil     DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size    Size    @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([productId, sizeId])
  @@index([tenantId])
}

/// Reusable group of options ("Adicionais", "Ponto da carne", "Borda").
model ModifierGroup {
  id          String    @id @default(cuid())
  tenantId    String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  name        String
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  options ModifierOption[]
  links   ModifierGroupLink[]

  @@index([tenantId])
}

model ModifierOption {
  id           String    @id @default(cuid())
  tenantId     String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  groupId      String
  /// Display name; combo options show the referenced product name instead.
  name         String
  priceCents   Int       @default(0)
  sortOrder    Int       @default(0)
  maxQuantity  Int       @default(1)
  /// Combo: option that is a menu product (name and sector come from the product).
  productId    String?
  isPaused     Boolean   @default(false)
  pausedUntil  DateTime?
  sku          String?
  externalCode String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  group      ModifierGroup             @relation(fields: [groupId], references: [id])
  product    Product?                  @relation(fields: [productId], references: [id], onDelete: SetNull)
  sizePrices ModifierOptionSizePrice[]

  @@index([tenantId, groupId, sortOrder])
}

model ModifierOptionSizePrice {
  id         String @id @default(cuid())
  tenantId   String @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  optionId   String
  sizeId     String
  priceCents Int

  option ModifierOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  size   Size           @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([optionId, sizeId])
  @@index([tenantId])
}

/// Link of a group to a category or a product (exactly one, CHECK), with its own limits/order.
model ModifierGroupLink {
  id         String   @id @default(cuid())
  tenantId   String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  groupId    String
  categoryId String?
  productId  String?
  minSelect  Int      @default(0)
  maxSelect  Int      @default(1)
  sortOrder  Int      @default(0)
  /// Product links only: removes a group inherited from the category.
  isDisabled Boolean  @default(false)
  createdAt  DateTime @default(now())

  group    ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product  Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([categoryId, groupId])
  @@unique([productId, groupId])
  @@index([tenantId, groupId])
}

/// Sale windows of a category or product (exactly one, CHECK). Windows may cross midnight.
model AvailabilitySchedule {
  id         String  @id @default(cuid())
  tenantId   String  @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  categoryId String?
  productId  String?
  /// 0 = Sunday ... 6 = Saturday
  weekday    Int
  /// "HH:mm"
  opensAt    String
  closesAt   String

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, categoryId])
  @@index([tenantId, productId])
}

// ============================================================================
// Orders (see docs/DECISOES.md D019–D022)
// ============================================================================

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum OrderSource {
  POS
  DIGITAL_MENU
  WAITER_APP
  IFOOD
  NINETY_NINE_FOOD
  AIQFOME
  OPEN_DELIVERY
  OTHER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  DISPATCHED
  DELIVERED
  CANCELED
}

enum OrderItemStatus {
  DRAFT
  QUEUED
  PREPARING
  READY
  SERVED
  CANCELED
}

enum DiscountType {
  VALUE
  PERCENT
}

enum CouponType {
  PERCENT
  FIXED
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  MEAL_VOUCHER
  ONLINE
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REFUNDED
}

enum OrderPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model Area {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tables Table[]

  @@index([tenantId, sortOrder])
}

model Table {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  areaId    String?
  /// Display name/number ("12", "Varanda 3").
  name      String
  seats     Int?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  area     Area?               @relation(fields: [areaId], references: [id], onDelete: SetNull)
  sessions TableSessionTable[]

  @@unique([tenantId, name])
  @@index([tenantId, areaId])
}

/// Physical occupation of one or more tables; may hold several open tabs (orders).
model TableSession {
  id              String    @id @default(cuid())
  tenantId        String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  guests          Int?
  waiterId        String?
  openedById      String?
  /// Pre-bill printed: the table is "aguardando pagamento" until a new round is sent.
  billRequestedAt DateTime?

  tables TableSessionTable[]
  orders Order[]

  @@index([tenantId, closedAt])
}

model TableSessionTable {
  id        String    @id @default(cuid())
  tenantId  String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  sessionId String
  tableId   String
  joinedAt  DateTime  @default(now())
  /// Set when the table leaves the session (session closed or table moved).
  leftAt    DateTime?

  session TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  table   Table        @relation(fields: [tableId], references: [id])

  @@index([tenantId, tableId, leftAt])
  @@index([sessionId])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  name      String
  /// Digits with DDD, no country code.
  phone     String
  document  String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses CustomerAddress[]
  orders    Order[]

  @@unique([tenantId, phone])
}

model CustomerAddress {
  id           String   @id @default(cuid())
  tenantId     String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  customerId   String
  label        String?
  cep          String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  reference    String?
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
}

/// Delivery person; userId is optional (freelancers may have no login).
model Courier {
  id               String   @id @default(cuid())
  tenantId         String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  name             String
  phone            String?
  userId           String?
  isActive         Boolean  @default(true)
  /// Pay overrides (null = the store rule).
  perDeliveryCents Int?
  feeShareBps      Int?
  dailyCents       Int?
  createdAt        DateTime @default(now())

  orders      Order[]
  runs        DeliveryRun[]
  settlements CourierSettlement[]
  ledger      CourierLedgerEntry[]

  @@index([tenantId])
}

model Coupon {
  id               String     @id @default(cuid())
  tenantId         String     @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  code             String
  type             CouponType
  /// PERCENT: basis points; FIXED: cents.
  value            Int
  minOrderCents    Int?
  maxDiscountCents Int?
  validFrom        DateTime?
  validUntil       DateTime?
  usageLimit       Int?
  usedCount        Int        @default(0)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())

  orders Order[]

  @@unique([tenantId, code])
}

/// Daily counter per unit (incremented atomically with INSERT ... ON CONFLICT).
model OrderSequence {
  tenantId     String
  businessDate String
  lastNumber   Int

  @@id([tenantId, businessDate])
}

/// A tab/order. Dine-in orders receive items in rounds; a table session may hold several.
model Order {
  id           String      @id @default(cuid())
  tenantId     String      @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  /// Business day (YYYY-MM-DD) the order belongs to (overnight shifts count for the start day).
  businessDate String
  /// Sequential number within the business day and unit.
  number       Int
  /// Short, non-sequential public code (customer tracking).
  publicCode   String      @unique
  type         OrderType
  source       OrderSource @default(POS)
  status       OrderStatus
  /// Optimistic concurrency: every change must send the version it saw.
  version      Int         @default(0)

  externalId        String?
  externalDisplayId String?
  externalPayload   Json?
  idempotencyKey    String?
  requestHash       String?

  tableSessionId String?
  /// Name of the tab inside the table (for example a guest name or a tab card number).
  tabLabel       String?

  customerId       String?
  customerName     String?
  customerPhone    String?
  customerDocument String?
  deliveryAddress  Json?
  courierId        String?

  subtotalCents          Int           @default(0)
  itemDiscountCents      Int           @default(0)
  orderDiscountType      DiscountType?
  orderDiscountValue     Int?
  orderDiscountReason    String?
  orderDiscountCents     Int           @default(0)
  couponId               String?
  couponCode             String?
  couponDiscountCents    Int           @default(0)
  serviceFeeBps          Int           @default(0)
  serviceFeeWaived       Boolean       @default(false)
  serviceFeeWaivedReason String?
  serviceFeeCents        Int           @default(0)
  deliveryFeeCents       Int           @default(0)
  totalCents             Int           @default(0)
  promoSavingsCents      Int           @default(0)

  expectedPaymentMethod PaymentMethod?
  changeForCents        Int?
  paidCents             Int                @default(0)
  paymentStatus         OrderPaymentStatus @default(UNPAID)

  notes            String?
  estimatedReadyAt DateTime?
  createdById      String?
  acceptedAt       DateTime?
  readyAt          DateTime?
  dispatchedAt     DateTime?
  deliveredAt      DateTime?
  canceledAt       DateTime?
  canceledById     String?
  cancelReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tableSession TableSession?        @relation(fields: [tableSessionId], references: [id])
  customer     Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  courier      Courier?             @relation(fields: [courierId], references: [id], onDelete: SetNull)
  coupon       Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  rounds       OrderRound[]
  items        OrderItem[]
  history      OrderStatusHistory[]
  payments     Payment[]
  tasks        ProductionTask[]
  delivery     OrderDelivery?
  stops        DeliveryStop[]

  @@unique([tenantId, businessDate, number])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, source, externalId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, tableSessionId])
}

/// One send to the kitchen. Counter/delivery orders have a single round.
model OrderRound {
  id        String    @id @default(cuid())
  tenantId  String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  orderId   String
  number    Int
  sentAt    DateTime?
  sentById  String?
  createdAt DateTime  @default(now())

  order Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items OrderItem[]
  tasks ProductionTask[]

  @@unique([orderId, number])
}

model OrderItem {
  id                    String          @id @default(cuid())
  tenantId              String          @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  orderId               String
  roundId               String
  /// Reference only; prices and names come from snapshot.
  productId             String?
  /// MenuItemSnapshot (v1) frozen at the time of sale.
  snapshot              Json
  name                  String
  sizeName              String?
  quantity              Int
  unitFullPriceCents    Int
  unitChargedPriceCents Int
  discountType          DiscountType?
  discountValue         Int?
  discountReason        String?
  discountCents         Int             @default(0)
  totalCents            Int
  sectorId              String?
  status                OrderItemStatus @default(DRAFT)
  notes                 String?
  sortOrder             Int             @default(0)
  sentAt                DateTime?
  startedAt             DateTime?
  readyAt               DateTime?
  servedAt              DateTime?
  canceledAt            DateTime?
  canceledById          String?
  cancelReason          String?
  createdAt             DateTime        @default(now())

  order Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  round OrderRound       @relation(fields: [roundId], references: [id])
  tasks ProductionTask[]

  @@index([tenantId, orderId])
  @@index([tenantId, sectorId, status])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  tenantId   String       @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  userId     String?
  reason     String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
}

model Payment {
  id                String        @id @default(cuid())
  tenantId          String        @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  orderId           String
  method            PaymentMethod
  amountCents       Int
  receivedCents     Int?
  changeCents       Int?
  status            PaymentStatus @default(CONFIRMED)
  /// Cash register that received it; null for online/marketplace payments (D024).
  cashSessionId     String?
  /// PIX txid (order public code), marketplace payment id, etc.
  externalRef       String?
  /// Card payments (optional, for reconciliation with the terminal): brand and
  /// authorization code / NSU. Credit or debit is the method itself.
  cardBrand         String?
  authorizationCode String?
  createdById       String?
  createdAt         DateTime      @default(now())
  refundedAt        DateTime?
  refundedById      String?
  refundReason      String?
  /// Cash register the refund left: the one open when it happened (a closed one never changes).
  refundSessionId   String?

  order         Order        @relation(fields: [orderId], references: [id])
  cashSession   CashSession? @relation("PaymentReceived", fields: [cashSessionId], references: [id], onDelete: Restrict)
  refundSession CashSession? @relation("PaymentRefunded", fields: [refundSessionId], references: [id], onDelete: Restrict)

  @@index([tenantId, orderId])
  @@index([tenantId, cashSessionId])
  @@index([tenantId, refundSessionId])
}

// ============================================================================
// Cash register (see docs/DECISOES.md D023–D025)
// ============================================================================

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  RANDOM
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SUPPLY
  WITHDRAWAL
}

/// Cash register ("caixa") of one operator: opening float, payments, supplies and
/// withdrawals, closing count per payment method.
model CashSession {
  id             String            @id @default(cuid())
  tenantId       String            @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  /// Business day of the opening (YYYY-MM-DD).
  businessDate   String
  operatorId     String
  status         CashSessionStatus @default(OPEN)
  /// operatorId while OPEN, null when closed: one open register per operator (unique).
  openOperatorId String?
  openingCents   Int
  openedAt       DateTime          @default(now())
  openedById     String
  closedAt       DateTime?
  closedById     String?
  closingNotes   String?
  reopenedAt     DateTime?
  reopenedById   String?
  reopenReason   String?
  version        Int               @default(0)

  movements CashMovement[]
  counts    CashSessionCount[]
  payments  Payment[]          @relation("PaymentReceived")
  refunds   Payment[]          @relation("PaymentRefunded")

  @@unique([tenantId, openOperatorId])
  @@index([tenantId, status])
  @@index([tenantId, businessDate])
}

/// Supply ("suprimento") or withdrawal ("sangria") of cash.
model CashMovement {
  id          String           @id @default(cuid())
  tenantId    String           @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  sessionId   String
  type        CashMovementType
  amountCents Int
  reason      String
  createdById String
  createdAt   DateTime         @default(now())

  session CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId])
}

/// Closing count, one row per payment method (expected frozen at closing time).
model CashSessionCount {
  id              String        @id @default(cuid())
  tenantId        String        @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  sessionId       String
  method          PaymentMethod
  expectedCents   Int
  countedCents    Int
  /// counted − expected (negative = missing).
  differenceCents Int

  session CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, method])
  @@index([tenantId, sessionId])
}

// ============================================================================
// Kitchen display (see docs/DECISOES.md D027–D028)
// ============================================================================

enum ProductionTaskStatus {
  QUEUED
  PREPARING
  READY
  CANCELED
}

enum ProductionTaskKind {
  /// The order line itself, in its sector.
  ITEM
  /// A combo option whose product belongs to another sector (combo drink at the bar).
  COMBO_PART
}

/// What one sector prepares of a sent order item. Created when the round is sent; a ticket is
/// (round, sector). Feeds the KDS and, later, printing per sector.
model ProductionTask {
  id                String               @id @default(cuid())
  tenantId          String               @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  orderId           String
  orderItemId       String
  roundId           String
  sectorId          String
  kind              ProductionTaskKind
  name              String
  quantity          Int
  /// TaskDetails (shared/domain/kds.ts): flavors, options, note and removals at send time.
  details           Json
  status            ProductionTaskStatus @default(QUEUED)
  sentAt            DateTime
  startedAt         DateTime?
  readyAt           DateTime?
  canceledAt        DateTime?
  /// How many times a "ready" was undone (mistakes; preparation time reports).
  recallCount       Int                  @default(0)
  /// Who marked it: a signed-in user or a KDS device.
  startedByUserId   String?
  startedByDeviceId String?
  readyByUserId     String?
  readyByDeviceId   String?

  order  Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item   OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  round  OrderRound       @relation(fields: [roundId], references: [id])
  sector ProductionSector @relation(fields: [sectorId], references: [id])

  @@index([tenantId, sectorId, status])
  @@index([tenantId, orderId])
  @@index([orderItemId])
}

/// Tablet or TV bound to sectors, signed in without a person's password (D028).
model KdsDevice {
  id               String    @id @default(cuid())
  tenantId         String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  name             String
  /// Sectors shown on this screen.
  sectorIds        String[]
  /// Also shows the expedition view (every sector, dispatch).
  showsExpedition  Boolean   @default(false)
  /// Hash of the long-lived device credential (httpOnly cookie, renewed on use).
  tokenHash        String?   @unique
  tokenExpiresAt   DateTime?
  /// Hash of the 6-digit pairing code, valid for a few minutes and a few attempts.
  pairingCodeHash  String?
  pairingExpiresAt DateTime?
  pairingFailures  Int       @default(0)
  pairedAt         DateTime?
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  revokedById      String?
  createdById      String
  createdAt        DateTime  @default(now())

  @@index([tenantId, revokedAt])
}

// ============================================================================
// Delivery (see docs/DECISOES.md D029–D031)
// ============================================================================

enum DeliveryAreaKind {
  NEIGHBORHOOD
  RADIUS
}

enum DeliveryAreaSource {
  /// Resolved from the address (neighborhood or radius).
  AUTO
  /// Chosen by the operator (geocoding failed or the neighborhood is unknown).
  MANUAL
  /// The store has no delivery areas: fee typed by hand.
  NONE
}

enum DeliveryRunStatus {
  OUT
  RETURNED
  SETTLED
}

enum DeliveryFailureReason {
  CUSTOMER_ABSENT
  ADDRESS_NOT_FOUND
  REFUSED
  OTHER
}

enum CourierLedgerType {
  /// Pay of a settlement (the restaurant owes the courier).
  EARNING
  /// Paid to the courier (register withdrawal).
  PAYOUT
  /// Missing cash deducted from the balance.
  SHORTAGE
}

/// Delivery area by neighborhood (name and variations) or radius from the store.
model DeliveryArea {
  id                String           @id @default(cuid())
  tenantId          String           @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  name              String
  kind              DeliveryAreaKind
  /// Neighborhood names and variations ("Centro", "Centro Histórico").
  neighborhoods     String[]
  city              String?
  radiusMeters      Int?
  feeCents          Int
  etaMinutes        Int
  minimumOrderCents Int?
  freeAboveCents    Int?
  /// Temporarily paused (rain, no courier); resumes at pausedUntil when set.
  pausedReason      String?
  pausedUntil       DateTime?
  sortOrder         Int              @default(0)
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  deliveries OrderDelivery[]

  @@index([tenantId, sortOrder])
}

/// Delivery data of an order: area snapshot, coordinates, suggested fee, attempts.
model OrderDelivery {
  id                String             @id @default(cuid())
  tenantId          String             @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  orderId           String             @unique
  areaId            String?
  areaName          String?
  areaSource        DeliveryAreaSource
  latitude          Float?
  longitude         Float?
  distanceMeters    Int?
  etaMinutes        Int?
  /// Fee the area suggested (a manual fee is compared against it and audited).
  suggestedFeeCents Int?
  feeChangeReason   String?
  attempts          Int                @default(0)

  order Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  area  DeliveryArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([tenantId, areaId])
}

/// A courier leaving with one or more orders on the same route.
model DeliveryRun {
  id            String            @id @default(cuid())
  tenantId      String            @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  courierId     String
  businessDate  String
  status        DeliveryRunStatus @default(OUT)
  /// courierId while OUT: one open route per courier (unique).
  openCourierId String?
  departedAt    DateTime          @default(now())
  returnedAt    DateTime?
  settlementId  String?
  createdById   String?

  courier    Courier            @relation(fields: [courierId], references: [id])
  settlement CourierSettlement? @relation(fields: [settlementId], references: [id])
  stops      DeliveryStop[]

  @@unique([tenantId, openCourierId])
  @@index([tenantId, courierId, status])
  @@index([tenantId, businessDate])
}

/// One delivery attempt of an order in a route: times, what the customer paid, or why not.
model DeliveryStop {
  id              String                 @id @default(cuid())
  tenantId        String                 @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  runId           String
  orderId         String
  sequence        Int
  dispatchedAt    DateTime               @default(now())
  deliveredAt     DateTime?
  failedAt        DateTime?
  failureReason   DeliveryFailureReason?
  failureNote     String?
  /// Declared by the courier ("como o cliente pagou"), confirmed at the settlement.
  collectedMethod PaymentMethod?
  collectedCents  Int?
  receivedCents   Int?
  changeCents     Int?
  collectedNote   String?

  run   DeliveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  order Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@index([runId])
}

/// Courier settlement: collected money into the settling register, differences, pay.
model CourierSettlement {
  id                    String   @id @default(cuid())
  tenantId              String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  courierId             String
  cashSessionId         String
  businessDate          String
  settledById           String
  settledAt             DateTime @default(now())
  deliveries            Int
  failedDeliveries      Int
  deliveryFeesCents     Int
  expectedCashCents     Int
  countedCashCents      Int
  cashDifferenceCents   Int
  expectedCardCents     Int
  countedCardCents      Int
  cardDifferenceCents   Int
  otherCents            Int
  perDeliveryCents      Int
  feeShareCents         Int
  dailyCents            Int
  earningsCents         Int
  previousBalanceCents  Int
  payoutCents           Int
  shortageDeductedCents Int
  newBalanceCents       Int
  courierOwesCents      Int
  notes                 String?

  courier Courier       @relation(fields: [courierId], references: [id])
  runs    DeliveryRun[]

  @@index([tenantId, courierId, settledAt])
  @@index([tenantId, businessDate])
}

/// Running balance of a courier (positive = the restaurant owes the courier).
model CourierLedgerEntry {
  id             String            @id @default(cuid())
  tenantId       String            @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  courierId      String
  type           CourierLedgerType
  /// + earnings; − payouts and deducted shortages.
  amountCents    Int
  settlementId   String?
  cashSessionId  String?
  cashMovementId String?
  reason         String?
  createdById    String
  createdAt      DateTime          @default(now())

  courier Courier @relation(fields: [courierId], references: [id])

  @@index([tenantId, courierId, createdAt])
}
