{
  "name": "@app/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo coverage"
  },
  "dependencies": {
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@types/node": "^24.9.0",
    "eslint": "^10.12.0",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.5"
  }
}
